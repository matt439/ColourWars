{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "ColourWars level format 1",
    "description": "Structural checks for the runtime format. Unknown keys are retained by the editor and ignored by the runtime. Resource resolution, float conversion, geometry relationships and station-name uniqueness still require runtime validation; collision objects take an optional material whose allowed values depend on collision_type; see level-format.md.",
    "type": "object",
    "required": [
        "display_name", "icon_frame", "sound", "spawn_locations", "level_bounds",
        "collision_objects", "non_collision_objects"
    ],
    "properties": {
        "format": { "type": "integer", "enum": [1] },
        "display_name": { "type": "string" },
        "icon_frame": { "type": "string" },
        "include_in_random": { "type": "boolean", "default": true },
        "sound": { "$ref": "#/definitions/sound" },
        "spawn_locations": {
            "type": "object",
            "required": ["team_a", "team_b"],
            "properties": {
                "team_a": { "$ref": "#/definitions/spawns" },
                "team_b": { "$ref": "#/definitions/spawns" }
            },
            "additionalProperties": true
        },
        "stations": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "x", "y"],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9_]+$",
                        "not": { "enum": ["spawn_a", "spawn_b"] }
                    },
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                },
                "additionalProperties": true
            }
        },
        "level_bounds": {
            "type": "object",
            "required": ["out_of_bounds", "camera_bounds", "zoom_out_start_bounds", "zoom_out_finish_bounds"],
            "properties": {
                "out_of_bounds": { "$ref": "#/definitions/rectangle" },
                "camera_bounds": { "$ref": "#/definitions/rectangle" },
                "zoom_out_start_bounds": { "$ref": "#/definitions/rectangle" },
                "zoom_out_finish_bounds": { "$ref": "#/definitions/rectangle" }
            },
            "additionalProperties": true
        },
        "collision_objects": {
            "type": "array",
            "items": {
                "oneOf": [
                    { "$ref": "#/definitions/structure" },
                    { "$ref": "#/definitions/paintable" },
                    { "$ref": "#/definitions/ramp" },
                    { "$ref": "#/definitions/fixed_slab" }
                ]
            }
        },
        "non_collision_objects": {
            "type": "array",
            "items": { "$ref": "#/definitions/visual" }
        }
    },
    "additionalProperties": true,
    "definitions": {
        "point": {
            "type": "object",
            "required": ["x", "y"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
            "additionalProperties": true
        },
        "spawns": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/point" } },
        "rectangle": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "width": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
                "height": { "type": "number", "minimum": 0, "exclusiveMinimum": true }
            },
            "additionalProperties": true
        },
        "rectangle_tlbr": {
            "type": "object",
            "required": ["left", "top", "right", "bottom"],
            "properties": {
                "left": { "type": "number" },
                "top": { "type": "number" },
                "right": { "type": "number" },
                "bottom": { "type": "number" }
            },
            "additionalProperties": true
        },
        "rectangle_geometry": {
            "anyOf": [
                {
                    "required": ["rectangle"],
                    "properties": { "rectangle": { "$ref": "#/definitions/rectangle" } }
                },
                {
                    "not": { "required": ["rectangle"] },
                    "required": ["rectangle_tlbr"],
                    "properties": { "rectangle_tlbr": { "$ref": "#/definitions/rectangle_tlbr" } }
                }
            ]
        },
        "triangle": {
            "type": "object",
            "required": ["x1", "y1", "x2", "y2", "x3", "y3"],
            "properties": {
                "x1": { "type": "number" }, "y1": { "type": "number" },
                "x2": { "type": "number" }, "y2": { "type": "number" },
                "x3": { "type": "number" }, "y3": { "type": "number" }
            },
            "additionalProperties": true
        },
        "colour": {
            "type": "string",
            "anyOf": [
                { "enum": ["BLACK", "DARK_GRAY", "DARK_GREY", "DIM_GRAY", "DIM_GREY", "GAINSBORO", "GRAY", "GREY", "LIGHT_GRAY", "LIGHT_GREY", "SILVER", "WHITE", "WHITE_SMOKE"] },
                { "pattern": "^[0-9A-Fa-f]{6}$" }
            ]
        },
        "material": {
            "description": "Optional terrain-atlas look of a collision object; absent keeps the stretched sheet/frame draw. Draft-04 has no if/then, so each collision definition narrows this enum to the values its collision_type allows.",
            "type": "string",
            "enum": ["ground", "pencil", "eraser", "paint_tin", "ruler", "set_square"]
        },
        "drift": {
            "description": "Optional horizontal decorative motion around the authored rectangle; distance is the maximum excursion in world units, period is seconds and phase is cycles. Drawn positions use the four-world-unit art grid.",
            "type": "object",
            "required": ["distance", "period", "phase"],
            "properties": {
                "distance": { "type": "number", "minimum": 0, "exclusiveMinimum": true, "maximum": 256 },
                "period": { "type": "number", "minimum": 1, "maximum": 3600 },
                "phase": { "type": "number", "minimum": 0, "maximum": 1, "exclusiveMaximum": true }
            },
            "additionalProperties": true
        },
        "motion": {
            "description": "Horizontal triangular translation of a flat paintable from its left anchor; period is the full round trip in seconds and phase is cycles. Float representability and scene/player admission remain runtime checks. Unknown metadata is ignored; axis, travel_y and rotation are unsupported requests.",
            "type": "object",
            "required": ["type", "travel_x", "period", "phase"],
            "properties": {
                "type": { "enum": ["horizontal"] },
                "travel_x": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
                "period": { "type": "number", "minimum": 0.03333333333333333 },
                "phase": { "type": "number", "minimum": 0, "maximum": 1, "exclusiveMaximum": true },
                "axis": { "not": {} },
                "travel_y": { "not": {} },
                "rotation": { "not": {} }
            },
            "additionalProperties": true
        },
        "object_common": {
            "type": "object",
            "required": ["type", "sheet_name", "frame_name", "colour"],
            "properties": {
                "type": { "type": "string" },
                "sheet_name": { "type": "string" },
                "frame_name": { "type": "string" },
                "colour": { "$ref": "#/definitions/colour" },
                "drift": { "$ref": "#/definitions/drift" },
                "motion": { "$ref": "#/definitions/motion" }
            },
            "dependencies": {
                "drift": { "properties": { "type": { "enum": ["Visual"] } } },
                "motion": { "properties": { "type": { "enum": ["StructurePaintable"] } } }
            },
            "additionalProperties": true
        },
        "structure": {
            "allOf": [
                { "$ref": "#/definitions/object_common" },
                { "$ref": "#/definitions/rectangle_geometry" },
                {
                    "required": ["collision_type"],
                    "properties": {
                        "type": { "enum": ["Structure"] },
                        "collision_type": { "enum": ["STRUCTURE", "STRUCTURE_JUMP_THROUGH"] },
                        "material": { "$ref": "#/definitions/material" }
                    }
                },
                {
                    "anyOf": [
                        { "not": { "required": ["material"] } },
                        {
                            "properties": {
                                "collision_type": { "enum": ["STRUCTURE"] },
                                "material": { "enum": ["ground"] }
                            }
                        },
                        {
                            "properties": {
                                "collision_type": { "enum": ["STRUCTURE_JUMP_THROUGH"] },
                                "material": { "enum": ["ruler"] }
                            }
                        }
                    ]
                }
            ]
        },
        "paintable": {
            "allOf": [
                { "$ref": "#/definitions/object_common" },
                { "$ref": "#/definitions/rectangle_geometry" },
                {
                    "required": ["collision_type", "paintable_faces"],
                    "properties": {
                        "type": { "enum": ["StructurePaintable"] },
                        "collision_type": { "enum": ["STRUCTURE_PAINTABLE", "STRUCTURE_JUMP_THROUGH"] },
                        "material": { "$ref": "#/definitions/material" },
                        "paintable_faces": {
                            "type": "object",
                            "required": ["left", "top", "right", "bottom"],
                            "properties": {
                                "left": { "type": "boolean" }, "top": { "type": "boolean" },
                                "right": { "type": "boolean" }, "bottom": { "type": "boolean" }
                            },
                            "additionalProperties": true
                        }
                    }
                },
                {
                    "anyOf": [
                        { "not": { "required": ["material"] } },
                        {
                            "properties": {
                                "collision_type": { "enum": ["STRUCTURE_PAINTABLE"] },
                                "material": { "enum": ["ground", "pencil", "eraser", "paint_tin"] }
                            }
                        },
                        {
                            "properties": {
                                "collision_type": { "enum": ["STRUCTURE_JUMP_THROUGH"] },
                                "material": { "enum": ["ruler"] }
                            }
                        }
                    ]
                }
            ]
        },
        "ramp": {
            "allOf": [
                { "$ref": "#/definitions/object_common" },
                {
                    "required": ["collision_type", "triangle"],
                    "properties": {
                        "type": { "enum": ["StructureRamp"] },
                        "collision_type": { "enum": ["STRUCTURE_RAMP_RIGHT", "STRUCTURE_RAMP_LEFT"] },
                        "triangle": { "$ref": "#/definitions/triangle" },
                        "material": {
                            "allOf": [
                                { "$ref": "#/definitions/material" },
                                { "enum": ["set_square"] }
                            ]
                        }
                    }
                }
            ]
        },
        "fixed_slab": {
            "description": "One fixed scored slab: 160-unit horizontal span, 80-unit rise and 24-unit normal thickness. slab.x/y is the endpoint with smaller X. It has a dedicated eraser material and no sprite or arbitrary rotation vocabulary.",
            "type": "object",
            "required": ["type", "collision_type", "material", "slab", "paintable_faces"],
            "properties": {
                "type": { "enum": ["FixedSlabPaintable"] },
                "collision_type": { "enum": ["STRUCTURE_FIXED_SLAB"] },
                "material": { "enum": ["eraser"] },
                "slab": {
                    "type": "object",
                    "required": ["x", "y", "rise"],
                    "properties": {
                        "x": { "type": "number", "minimum": -65536, "maximum": 65376 },
                        "y": { "type": "number", "minimum": -65536, "maximum": 65536 },
                        "rise": { "enum": ["left", "right"] },
                        "width": { "not": {} }, "height": { "not": {} },
                        "angle": { "not": {} }, "rotation": { "not": {} },
                        "thickness": { "not": {} }, "motion": { "not": {} }
                    },
                    "oneOf": [
                        { "properties": { "rise": { "enum": ["right"] }, "y": { "minimum": -65456 } } },
                        { "properties": { "rise": { "enum": ["left"] }, "y": { "maximum": 65456 } } }
                    ],
                    "additionalProperties": true
                },
                "paintable_faces": {
                    "type": "object",
                    "required": ["left", "top", "right", "bottom"],
                    "properties": {
                        "left": { "type": "boolean" }, "top": { "type": "boolean" },
                        "right": { "type": "boolean" }, "bottom": { "type": "boolean" }
                    },
                    "additionalProperties": true
                },
                "motion": { "not": {} }, "drift": { "not": {} },
                "rotation": { "not": {} }, "rectangle": { "not": {} },
                "rectangle_tlbr": { "not": {} }, "triangle": { "not": {} }
            },
            "additionalProperties": true
        },
        "visual": {
            "allOf": [
                { "$ref": "#/definitions/object_common" },
                { "$ref": "#/definitions/rectangle_geometry" },
                { "properties": { "type": { "enum": ["Visual"] } } }
            ]
        },
        "sound": {
            "type": "object",
            "required": ["sound_bank_name"],
            "properties": {
                "sound_bank_name": { "type": "string" },
                "music_name": { "type": "string" },
                "music_volume": { "type": "number", "minimum": 0, "maximum": 1 },
                "end_sting_name": { "type": "string" },
                "end_sting_volume": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "dependencies": {
                "music_name": ["music_volume"], "music_volume": ["music_name"],
                "end_sting_name": ["end_sting_volume"], "end_sting_volume": ["end_sting_name"]
            },
            "additionalProperties": true
        }
    }
}
