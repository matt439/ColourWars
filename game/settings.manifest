<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3" >
   <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
       <application>
           <!-- Windows Vista -->
           <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
           <!-- Windows 7 -->
           <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
           <!-- Windows 8 -->
           <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
           <!-- Windows 8.1 -->
           <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
           <!-- Windows 10 / Windows 11 -->
           <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
       </application>
   </compatibility>
   <!-- Per-monitor DPI awareness, declared here rather than by a call so the
        process is aware before the engine creates its window. Without it a
        scaled display (125%/150%) bitmap-stretches every point-sampled frame.
        dpiAwareness (Windows 10 1607+) takes the first value it understands;
        dpiAware is what older Windows reads. scripts/check-startup.ps1 holds
        the built executable to PerMonitorV2. Under it the engine's window keeps
        the client pixel size the game asked for, across DPI changes too; this
        declaration is what opts in (docs/review/engine-reports.md, report 17). -->
   <asmv3:application>
       <asmv3:windowsSettings>
           <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
           <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
       </asmv3:windowsSettings>
   </asmv3:application>
</assembly>
