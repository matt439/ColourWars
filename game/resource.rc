#include <winres.h>
#include "game/version.rc.h"

// The engine loads the window icon by this name (LoadIconW(instance, L"IDI_ICON")).
IDI_ICON                ICON                    "colourwars.ico"

// Explorer's Properties > Details. The number is project(VERSION) in the root
// CMakeLists.txt; scripts/check-startup.ps1 checks it is stamped.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION COLOURWARS_VERSION_NUMBERS
 PRODUCTVERSION COLOURWARS_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Matt Harding"
            VALUE "FileDescription", "ColourWars"
            VALUE "FileVersion", COLOURWARS_VERSION_STRING
            VALUE "InternalName", "ColourWars"
            VALUE "LegalCopyright", "Copyright (c) 2022-2026 Matt Harding"
            VALUE "OriginalFilename", "ColourWars.exe"
            VALUE "ProductName", "ColourWars"
            VALUE "ProductVersion", COLOURWARS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
