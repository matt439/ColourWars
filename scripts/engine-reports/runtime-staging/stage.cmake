# A small synthetic client workaround, not a proposed engine implementation.
# It removes only a missing, explicitly declared optional FILE. It does not
# prune directories or infer which unlisted files a client meant to ship.
cmake_minimum_required(VERSION 3.26)
foreach(required CONTENT_DIR BUILD_DIR STAGE_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "stage.cmake needs ${required}")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/asset-list.cmake")

# REAL_PATH requires an existing path. Resolve an existing prefix and append
# missing components lexically, so a first build is valid without overlooking
# a linked existing parent. A dangling link is an error rather than a suffix.
function(resolve_existing_prefix input_path output_name)
    set(existing_prefix "${input_path}")
    set(missing_suffix "")
    while(NOT EXISTS "${existing_prefix}")
        if(IS_SYMLINK "${existing_prefix}")
            message(FATAL_ERROR "Fixture path has a dangling link: ${input_path}")
        endif()
        get_filename_component(component "${existing_prefix}" NAME)
        get_filename_component(parent "${existing_prefix}" DIRECTORY)
        if(parent STREQUAL existing_prefix OR component STREQUAL "")
            message(FATAL_ERROR "Fixture path has no existing prefix: ${input_path}")
        endif()
        list(PREPEND missing_suffix "${component}")
        set(existing_prefix "${parent}")
    endwhile()
    file(REAL_PATH "${existing_prefix}" resolved)
    foreach(component IN LISTS missing_suffix)
        cmake_path(APPEND resolved "${component}")
    endforeach()
    set(${output_name} "${resolved}" PARENT_SCOPE)
endfunction()

if(NOT IS_DIRECTORY "${CONTENT_DIR}" OR NOT IS_DIRECTORY "${BUILD_DIR}")
    message(FATAL_ERROR "Fixture content and build roots must already exist")
endif()
file(REAL_PATH "${CONTENT_DIR}" content_root)
file(REAL_PATH "${BUILD_DIR}" build_root)
resolve_existing_prefix("${STAGE_DIR}" stage_root)
set(expected_stage "${build_root}/run")
cmake_path(IS_PREFIX content_root "${stage_root}" NORMALIZE stage_in_content)
cmake_path(IS_PREFIX stage_root "${content_root}" NORMALIZE content_in_stage)
if(NOT stage_root STREQUAL expected_stage OR IS_SYMLINK "${STAGE_DIR}"
    OR stage_in_content OR content_in_stage)
    message(FATAL_ERROR "Fixture staging must be this build's run/ directory, separate from content")
endif()

set(all_assets ${REQUIRED_ASSETS} ${OPTIONAL_ASSETS})
set(unique_assets ${all_assets})
list(REMOVE_DUPLICATES unique_assets)
list(LENGTH all_assets all_count)
list(LENGTH unique_assets unique_count)
if(NOT all_count EQUAL unique_count)
    message(FATAL_ERROR "Duplicate or overlapping asset declarations")
endif()

# Validate all inputs and destinations before replacing any existing output.
set(present_assets "")
set(absent_optional "")
foreach(asset IN LISTS all_assets)
    cmake_path(NORMAL_PATH asset OUTPUT_VARIABLE normalized_asset)
    cmake_path(IS_ABSOLUTE asset absolute_asset)
    if(absolute_asset OR NOT asset STREQUAL normalized_asset
        OR asset STREQUAL "" OR asset MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Asset must be a normalized relative file: ${asset}")
    endif()
    set(source "${content_root}/${asset}")
    set(destination "${stage_root}/${asset}")
    resolve_existing_prefix("${source}" source_resolved)
    resolve_existing_prefix("${destination}" destination_resolved)
    if(IS_SYMLINK "${source}" OR NOT source STREQUAL source_resolved
        OR IS_SYMLINK "${destination}" OR NOT destination STREQUAL destination_resolved
        OR IS_DIRECTORY "${source}" OR IS_DIRECTORY "${destination}")
        message(FATAL_ERROR "Fixture asset paths must be ordinary files without linked parents: ${asset}")
    endif()
    if(EXISTS "${source}")
        list(APPEND present_assets "${asset}")
    elseif(asset IN_LIST OPTIONAL_ASSETS)
        list(APPEND absent_optional "${asset}")
    else()
        message(FATAL_ERROR "Missing required runtime asset: ${asset}")
    endif()
endforeach()

set(removed_count 0)
foreach(asset IN LISTS absent_optional)
    set(destination "${stage_root}/${asset}")
    if(EXISTS "${destination}")
        # The literal path and its parents were checked above. No recursive
        # deletion and no deletion outside this exact declared file list.
        file(REMOVE "${destination}")
        if(EXISTS "${destination}")
            message(FATAL_ERROR "Could not remove stale optional asset: ${asset}")
        endif()
        math(EXPR removed_count "${removed_count} + 1")
    endif()
endforeach()
foreach(asset IN LISTS present_assets)
    get_filename_component(directory "${asset}" DIRECTORY)
    file(MAKE_DIRECTORY "${stage_root}/${directory}")
    file(COPY_FILE "${content_root}/${asset}" "${stage_root}/${asset}" ONLY_IF_DIFFERENT)
endforeach()
list(LENGTH present_assets present_count)
message(STATUS "Staged ${present_count} explicitly listed assets; removed ${removed_count} missing optional files")
