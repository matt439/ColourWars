# The accepted, redistributable bank is tracked. Verify its receipt and runtime
# definition on every build; normal builds need neither Python nor FFmpeg.
# An absent bank deliberately retains the manifest's optional silent fallback.
cmake_minimum_required(VERSION 3.26)
if(NOT DEFINED BANK_DIR)
    message(FATAL_ERROR "check_wave_bank.cmake needs BANK_DIR")
endif()
if(NOT DEFINED RECEIPT)
    set(RECEIPT "${CMAKE_CURRENT_LIST_DIR}/../scripts/audio/runtime-bank.json")
endif()
set(definition "${BANK_DIR}/paint_exe.json")
set(bank "${BANK_DIR}/paint_exe.xwb")
file(READ "${RECEIPT}" receipt)
file(READ "${definition}" definition_text)
string(JSON wave_count LENGTH "${definition_text}" waves)
string(JSON expected_count LENGTH "${receipt}" waves)
if(NOT wave_count EQUAL expected_count OR wave_count EQUAL 0)
    message(FATAL_ERROR "wave bank: runtime definition and accepted bank wave counts differ")
endif()
string(JSON auto_effects GET "${definition_text}" create_effect_instance_for_each_wave)
if(auto_effects)
    message(FATAL_ERROR "wave bank: effect instances must be named explicitly")
endif()
set(waves "")
math(EXPR last "${wave_count} - 1")
foreach(index RANGE ${last})
    string(JSON wave GET "${definition_text}" waves ${index})
    string(JSON expected GET "${receipt}" waves ${index})
    if(NOT wave STREQUAL expected OR wave IN_LIST waves)
        message(FATAL_ERROR "wave bank: runtime wave '${wave}' differs from accepted bank entry ${index}")
    endif()
    list(APPEND waves "${wave}")
endforeach()
string(JSON instance_count LENGTH "${definition_text}" sound_effect_instances)
set(instances "")
if(instance_count GREATER 0)
    math(EXPR last "${instance_count} - 1")
    foreach(index RANGE ${last})
        string(JSON instance GET "${definition_text}" sound_effect_instances ${index} name)
        string(JSON wave GET "${definition_text}" sound_effect_instances ${index} wave)
        if(NOT wave IN_LIST waves OR instance IN_LIST instances)
            message(FATAL_ERROR "wave bank: invalid or duplicate effect instance '${instance}' on '${wave}'")
        endif()
        list(APPEND instances "${instance}")
    endforeach()
endif()
if(NOT EXISTS "${bank}")
    if(REQUIRE_BANK)
        message(FATAL_ERROR "wave bank: the audible release requires paint_exe.xwb")
    endif()
    message(STATUS "wave bank: paint_exe.xwb is absent; using the optional silent fallback")
    return()
endif()
file(SHA256 "${bank}" actual_hash)
string(JSON expected_hash GET "${receipt}" sha256)
file(SIZE "${bank}" actual_size)
string(JSON expected_size GET "${receipt}" bytes)
if(NOT actual_hash STREQUAL expected_hash OR NOT actual_size EQUAL expected_size)
    message(FATAL_ERROR "wave bank: paint_exe.xwb differs from its accepted build receipt; reproduce and publish it with scripts/audio/")
endif()
