# Script-only regression for the runtime mirror, requiring no compiler/device.
# Run with cmake -DTEST_DIR=<scratch directory> -P cmake/check_runtime_staging.cmake.
cmake_minimum_required(VERSION 3.26)
if(NOT DEFINED TEST_DIR OR TEST_DIR STREQUAL "")
    message(FATAL_ERROR "check_runtime_staging.cmake needs TEST_DIR")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/runtime_assets.cmake")
file(REAL_PATH "${TEST_DIR}" test_root)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(fixture "${test_root}/runtime-staging-${run_id}")
set(source "${fixture}/content")
set(build "${fixture}/build")
set(stage "${build}/game")
file(MAKE_DIRECTORY "${source}" "${build}")
foreach(asset IN LISTS COLOURWARS_RUNTIME_ASSETS)
    get_filename_component(directory "${asset}" DIRECTORY)
    file(MAKE_DIRECTORY "${source}/${directory}")
    file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../game/content/${asset}"
        "${source}/${asset}")
endforeach()
set(stager "${CMAKE_CURRENT_LIST_DIR}/stage_runtime_assets.cmake")

function(remove_fixture_directory path)
    file(REAL_PATH "${fixture}" fixture_root)
    file(REAL_PATH "${path}" resolved)
    cmake_path(IS_PREFIX fixture_root "${resolved}" NORMALIZE in_fixture)
    if(NOT in_fixture OR resolved STREQUAL fixture_root OR IS_SYMLINK "${path}")
        message(FATAL_ERROR "Refusing to remove a path outside this test fixture: ${path}")
    endif()
    file(REMOVE_RECURSE "${resolved}")
endfunction()

function(create_fixture_directory_link target link)
    file(CREATE_LINK "${target}" "${link}" SYMBOLIC RESULT result)
    if(NOT result STREQUAL "0" AND WIN32)
        # Windows file symlinks need a privilege not held by ordinary shells;
        # directory junctions exercise the same path checks without it.
        file(WRITE "${fixture}/junction.ps1"
            "param([string]$Link, [string]$Target)\nNew-Item -ItemType Junction -Path $Link -Target $Target -ErrorAction Stop | Out-Null\n")
        execute_process(COMMAND powershell.exe -NoProfile -File "${fixture}/junction.ps1"
            -Link "${link}" -Target "${target}"
            RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    endif()
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not create a directory link for staging checks: ${result} ${error}")
    endif()
endfunction()

function(stage_content destination expect_success)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DCONTENT_DIR=${source}" "-DBUILD_DIR=${build}"
        "-DSTAGE_DIR=${destination}" -P "${stager}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expect_success AND NOT result EQUAL 0)
        message(FATAL_ERROR "Staging failed: ${output}${error}")
    elseif(NOT expect_success AND result EQUAL 0)
        message(FATAL_ERROR "Staging unexpectedly accepted unsafe/invalid input: ${destination}")
    endif()
    if(NOT expect_success AND ARGC GREATER 2)
        string(FIND "${output}${error}" "${ARGV2}" diagnostic)
        if(diagnostic EQUAL -1)
            message(FATAL_ERROR "Expected '${ARGV2}' diagnostic, received: ${output}${error}")
        endif()
    endif()
endfunction()

function(check_mirror optional_bank)
    set(expected "${COLOURWARS_RUNTIME_ASSETS}")
    if(NOT optional_bank)
        list(REMOVE_ITEM expected sounds/paint_exe.xwb)
    endif()
    set(actual manifest.json tuning.json presentation.json)
    foreach(directory IN LISTS COLOURWARS_RUNTIME_DIRECTORIES)
        file(GLOB_RECURSE entries LIST_DIRECTORIES FALSE RELATIVE "${stage}"
            "${stage}/${directory}/*")
        list(APPEND actual ${entries})
    endforeach()
    list(SORT expected)
    list(SORT actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Runtime mirror differs from allow-list: ${actual}")
    endif()
    foreach(asset IN LISTS expected)
        file(SHA256 "${source}/${asset}" source_hash)
        file(SHA256 "${stage}/${asset}" staged_hash)
        if(NOT source_hash STREQUAL staged_hash)
            message(FATAL_ERROR "Runtime mirror did not copy ${asset}")
        endif()
    endforeach()
endfunction()

# An empty output receives exactly the runtime files.
stage_content("${stage}" TRUE)
check_mirror(TRUE)

# An old mirror loses unreviewed files and nested authoring directories, while
# root files and unrelated output directories remain untouched.
foreach(directory IN LISTS COLOURWARS_RUNTIME_DIRECTORIES)
    file(MAKE_DIRECTORY "${stage}/${directory}/old/nested")
    file(WRITE "${stage}/${directory}/old/nested/source.txt" "stale")
    file(WRITE "${stage}/${directory}/old.png" "stale")
endforeach()
file(WRITE "${stage}/keep.dll" "root sentinel")
file(MAKE_DIRECTORY "${stage}/captures")
file(WRITE "${stage}/captures/keep.txt" "outside owned directories")
file(WRITE "${stage}/textures/weapon_paint.json" "outdated")
stage_content("${stage}" TRUE)
check_mirror(TRUE)
foreach(directory IN LISTS COLOURWARS_RUNTIME_DIRECTORIES)
    if(EXISTS "${stage}/${directory}/old")
        message(FATAL_ERROR "Stale nested directory survived staging: ${directory}")
    endif()
endforeach()
file(READ "${stage}/keep.dll" sentinel)
if(NOT sentinel STREQUAL "root sentinel" OR NOT EXISTS "${stage}/captures/keep.txt")
    message(FATAL_ERROR "Staging changed files outside its owned directories")
endif()

# Missing audio removes the already staged bank; restoring it copies it back.
file(REMOVE "${source}/sounds/paint_exe.xwb")
stage_content("${stage}" TRUE)
check_mirror(FALSE)
file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../game/content/sounds/paint_exe.xwb"
    "${source}/sounds/paint_exe.xwb")
stage_content("${stage}" TRUE)
check_mirror(TRUE)

# Invalid present audio fails before pruning the existing output.
file(WRITE "${source}/sounds/paint_exe.xwb" "invalid bank")
file(WRITE "${stage}/textures/leave-on-failure.txt" "sentinel")
stage_content("${stage}" FALSE)
if(NOT EXISTS "${stage}/textures/leave-on-failure.txt")
    message(FATAL_ERROR "Failed audio validation changed the existing mirror")
endif()
file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../game/content/sounds/paint_exe.xwb"
    "${source}/sounds/paint_exe.xwb")

# Source/destination file-type conflicts must also fail before stale cleanup.
file(RENAME "${source}/textures/weapon_paint.json" "${source}/textures/weapon_paint.saved")
file(MAKE_DIRECTORY "${source}/textures/weapon_paint.json")
stage_content("${stage}" FALSE "Runtime source asset must be a file")
if(NOT EXISTS "${stage}/textures/leave-on-failure.txt")
    message(FATAL_ERROR "Invalid source file type changed the existing mirror")
endif()
remove_fixture_directory("${source}/textures/weapon_paint.json")
file(RENAME "${source}/textures/weapon_paint.saved" "${source}/textures/weapon_paint.json")
file(REMOVE "${stage}/textures/weapon_paint.json")
file(MAKE_DIRECTORY "${stage}/textures/weapon_paint.json")
stage_content("${stage}" FALSE "Runtime staging destination must be a file")
if(NOT EXISTS "${stage}/textures/leave-on-failure.txt")
    message(FATAL_ERROR "Invalid destination file type changed the existing mirror")
endif()
remove_fixture_directory("${stage}/textures/weapon_paint.json")
file(COPY_FILE "${source}/textures/weapon_paint.json" "${stage}/textures/weapon_paint.json")

# A file occupying an owned directory must fail before pruning other folders.
file(RENAME "${stage}/fonts" "${stage}/fonts.saved")
file(WRITE "${stage}/fonts" "file in place of directory")
stage_content("${stage}" FALSE "Runtime staging content path must be a directory")
if(NOT EXISTS "${stage}/textures/leave-on-failure.txt")
    message(FATAL_ERROR "Invalid content directory type changed the existing mirror")
endif()
file(REMOVE "${stage}/fonts")
file(RENAME "${stage}/fonts.saved" "${stage}/fonts")

# Reject the source itself, its ancestor, and destinations outside build/game.
stage_content("${source}" FALSE)
stage_content("${fixture}" FALSE)
stage_content("${build}/elsewhere" FALSE)
if(NOT EXISTS "${stage}/textures/leave-on-failure.txt")
    message(FATAL_ERROR "Rejected destination changed the existing mirror")
endif()
stage_content("${stage}" TRUE)
check_mirror(TRUE)

# A root runtime file link must not let copying overwrite another output.
file(WRITE "${fixture}/outside.txt" "link sentinel")
file(REMOVE "${stage}/manifest.json")
file(CREATE_LINK "${fixture}/outside.txt" "${stage}/manifest.json"
    SYMBOLIC RESULT root_link_result)
if(root_link_result STREQUAL "0")
    stage_content("${stage}" FALSE "linked runtime asset")
    file(READ "${fixture}/outside.txt" sentinel)
    if(NOT sentinel STREQUAL "link sentinel")
        message(FATAL_ERROR "Runtime staging wrote through a root file link")
    endif()
    file(REMOVE "${stage}/manifest.json")
else()
    message(STATUS "Root file link check unavailable: ${root_link_result}")
    create_fixture_directory_link("${stage}/captures" "${stage}/manifest.json")
    stage_content("${stage}" FALSE "linked runtime asset")
    if(NOT EXISTS "${stage}/captures/keep.txt")
        message(FATAL_ERROR "Runtime staging followed a root directory link")
    endif()
    file(REMOVE "${stage}/manifest.json")
endif()
file(COPY_FILE "${source}/manifest.json" "${stage}/manifest.json")

# A nested directory link must not let recursive cleanup reach another tree.
create_fixture_directory_link("${stage}/captures" "${stage}/textures/linked")
stage_content("${stage}" FALSE "linked content entry")
if(NOT EXISTS "${stage}/captures/keep.txt")
    message(FATAL_ERROR "Runtime staging followed a nested directory link")
endif()
file(REMOVE "${stage}/textures/linked")
check_mirror(TRUE)
message(STATUS "Runtime staging checks passed; fixtures: ${fixture}")
