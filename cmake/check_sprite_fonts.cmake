# The seven runtime atlases are tracked output of a recipe
# (game/art/sources/fonts/fonts.json) that scripts/build-fonts.ps1 runs with
# MakeSpriteFont. Regeneration needs installed Office faces, so it is never part
# of a build. What a build can check without the tool is that each atlas is the
# shape the recipe and the game expect: the DXTKfont layout, exactly the glyph
# region drawable_text accepts and nothing else, no default character, the
# recipe's texture size and format, and no bytes past the texture.
# Run with cmake -DFONT_DIR=<content>/fonts -P cmake/check_sprite_fonts.cmake.
cmake_minimum_required(VERSION 3.26)
if(NOT DEFINED FONT_DIR)
    message(FATAL_ERROR "check_sprite_fonts.cmake needs FONT_DIR")
endif()
if(NOT DEFINED RECIPE)
    set(RECIPE "${CMAKE_CURRENT_LIST_DIR}/../game/art/sources/fonts/fonts.json")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/runtime_assets.cmake")

# A little-endian uint32 at a byte offset into a HEX string.
function(hex_u32 hex byte_offset out)
    math(EXPR at "${byte_offset} * 2")
    string(SUBSTRING "${hex}" ${at} 8 word)
    string(LENGTH "${word}" length)
    if(NOT length EQUAL 8)
        message(FATAL_ERROR "sprite fonts: read past the end of a header")
    endif()
    string(SUBSTRING "${word}" 0 2 b0)
    string(SUBSTRING "${word}" 2 2 b1)
    string(SUBSTRING "${word}" 4 2 b2)
    string(SUBSTRING "${word}" 6 2 b3)
    math(EXPR value "0x${b3}${b2}${b1}${b0}")
    set(${out} ${value} PARENT_SCOPE)
endfunction()

file(READ "${RECIPE}" recipe)
string(JSON first GET "${recipe}" character_region first)
string(JSON last GET "${recipe}" character_region last)
string(JSON expected_default GET "${recipe}" default_character)
string(JSON expected_format GET "${recipe}" dxgi_format)
string(JSON font_count LENGTH "${recipe}" fonts)
math(EXPR expected_glyphs "${last} - ${first} + 1")

# The recipe and the reviewed runtime list must name the same atlases.
set(runtime_fonts "")
foreach(asset IN LISTS COLOURWARS_RUNTIME_ASSETS)
    if(asset MATCHES "^fonts/(.+)$")
        list(APPEND runtime_fonts "${CMAKE_MATCH_1}")
    endif()
endforeach()
set(recipe_fonts "")
math(EXPR last_font "${font_count} - 1")
foreach(index RANGE ${last_font})
    string(JSON name GET "${recipe}" fonts ${index} file)
    list(APPEND recipe_fonts "${name}")
endforeach()
list(SORT runtime_fonts)
set(sorted_recipe "${recipe_fonts}")
list(SORT sorted_recipe)
if(NOT runtime_fonts STREQUAL sorted_recipe)
    message(FATAL_ERROR "sprite fonts: game/art/sources/fonts/fonts.json and cmake/runtime_assets.cmake name different atlases")
endif()

foreach(index RANGE ${last_font})
    string(JSON name GET "${recipe}" fonts ${index} file)
    string(JSON expected_width GET "${recipe}" fonts ${index} texture width)
    string(JSON expected_height GET "${recipe}" fonts ${index} texture height)
    set(atlas "${FONT_DIR}/${name}")
    if(NOT EXISTS "${atlas}")
        message(FATAL_ERROR "sprite fonts: ${name} is missing")
    endif()
    file(READ "${atlas}" magic LIMIT 12 HEX)
    string(SUBSTRING "${magic}" 0 16 signature)
    if(NOT signature STREQUAL "4458544b666f6e74")
        message(FATAL_ERROR "sprite fonts: ${name} is not a DXTKfont atlas")
    endif()
    hex_u32("${magic}" 8 glyphs)
    if(NOT glyphs EQUAL expected_glyphs)
        message(FATAL_ERROR "sprite fonts: ${name} has ${glyphs} glyphs; the recipe region ${first}-${last} has ${expected_glyphs}. Regenerate it with scripts/build-fonts.ps1")
    endif()
    math(EXPR table_bytes "${glyphs} * 32")
    file(READ "${atlas}" table OFFSET 12 LIMIT ${table_bytes} HEX)
    math(EXPR last_glyph "${glyphs} - 1")
    foreach(glyph RANGE ${last_glyph})
        math(EXPR at "${glyph} * 32")
        hex_u32("${table}" ${at} character)
        math(EXPR wanted "${first} + ${glyph}")
        if(NOT character EQUAL wanted)
            message(FATAL_ERROR "sprite fonts: ${name} glyph ${glyph} is character ${character}, not ${wanted}; the atlas must hold exactly the recipe region")
        endif()
    endforeach()
    math(EXPR trailer_offset "12 + ${table_bytes}")
    file(READ "${atlas}" trailer OFFSET ${trailer_offset} LIMIT 28 HEX)
    hex_u32("${trailer}" 4 default_character)
    hex_u32("${trailer}" 8 width)
    hex_u32("${trailer}" 12 height)
    hex_u32("${trailer}" 16 format)
    hex_u32("${trailer}" 20 stride)
    hex_u32("${trailer}" 24 rows)
    if(NOT default_character EQUAL expected_default)
        message(FATAL_ERROR "sprite fonts: ${name} default character is ${default_character}, not the recipe's ${expected_default}")
    endif()
    if(NOT format EQUAL expected_format)
        message(FATAL_ERROR "sprite fonts: ${name} texture format is DXGI ${format}, not the recipe's ${expected_format}")
    endif()
    if(NOT width EQUAL expected_width OR NOT height EQUAL expected_height)
        message(FATAL_ERROR "sprite fonts: ${name} texture is ${width}x${height}, not the recipe's ${expected_width}x${expected_height}")
    endif()
    file(SIZE "${atlas}" size)
    math(EXPR expected_size "${trailer_offset} + 28 + ${stride} * ${rows}")
    if(NOT size EQUAL expected_size)
        message(FATAL_ERROR "sprite fonts: ${name} is ${size} bytes; its header describes ${expected_size}")
    endif()
endforeach()
