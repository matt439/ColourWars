# One manifest-kind to runtime-file rule for packaging and source registration.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_LIST_DIR}/manifest_asset_kinds.json")
file(READ "${CMAKE_CURRENT_LIST_DIR}/manifest_asset_kinds.json" COLOURWARS_MANIFEST_ASSET_KINDS)

function(colourwars_manifest_extensions output kind)
    string(JSON values ERROR_VARIABLE problem GET "${COLOURWARS_MANIFEST_ASSET_KINDS}" "${kind}")
    if(problem)
        message(FATAL_ERROR "Review release assets for new manifest kind: ${kind}")
    endif()
    string(JSON count LENGTH "${values}")
    if(count LESS 1)
        message(FATAL_ERROR "Manifest kind ${kind} needs at least one runtime extension")
    endif()
    math(EXPR last "${count} - 1")
    set(extensions "")
    foreach(index RANGE 0 ${last})
        string(JSON extension GET "${values}" ${index})
        if(NOT extension MATCHES "^[a-z0-9]+$")
            message(FATAL_ERROR "Invalid runtime extension for ${kind}: ${extension}")
        endif()
        list(APPEND extensions "${extension}")
    endforeach()
    set(${output} "${extensions}" PARENT_SCOPE)
endfunction()

function(colourwars_configure_manifest_kinds output)
    string(JSON count LENGTH "${COLOURWARS_MANIFEST_ASSET_KINDS}")
    math(EXPR last "${count} - 1")
    set(COLOURWARS_MANIFEST_KIND_ROWS "")
    foreach(index RANGE 0 ${last})
        string(JSON kind MEMBER "${COLOURWARS_MANIFEST_ASSET_KINDS}" ${index})
        if(NOT kind MATCHES "^[a-z_]+$")
            message(FATAL_ERROR "Invalid manifest kind: ${kind}")
        endif()
        colourwars_manifest_extensions(extensions "${kind}")
        foreach(extension IN LISTS extensions)
            string(APPEND COLOURWARS_MANIFEST_KIND_ROWS "        { \"${kind}\", \"${extension}\" },\n")
        endforeach()
    endforeach()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/manifest_asset_kinds.h.in" "${output}" @ONLY)
endfunction()
